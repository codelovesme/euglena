-- v1.1 gives an organelle a way to speak first: http_server pushes Request,
-- a handler answers by returning Response, and loop { } keeps the cell up
-- to receive it. No request_id bookkeeping — the module remembers who to
-- answer.

Request { method, path } => {
    if path = "/health" {
        return Response { status = 200, body = "ok" }
    }
    return Response { status = 404, body = "not found" }
}

emit Config { port = 8080 } to server
emit Listen { } to server
loop {
}
