| The ui gene, exercised as a fixture: every component's tree, the press
| it carries, and the stylesheet in both themes. `Palette` and `Metrics`
| are stubbed rather than linked: the real palette reads the theme from a
| browser's storage, and there is none here. `theme` picks the stub.

link "../ui.gene.code"

theme = "dark"

Palette =>
    if theme = "light"
        return Colours { bg = "#fff", panel = "#f6f8fa", line = "#d0d7de", fg = "#1f2328", muted = "#656d76", accent = "#0969da", accent_soft = "#ddf4ff", danger_soft = "#ffebe9", health = "#1a7f37", danger = "#cf222e", warn = "#9a6700", hover = "#eaeef2" }
    return Colours { bg = "#0d1117", panel = "#161b22", line = "#30363d", fg = "#e6edf3", muted = "#9da7b3", accent = "#2f81f7", accent_soft = "#17243a", danger_soft = "#321b20", health = "#3fb950", danger = "#f85149", warn = "#d29922", hover = "#1f242d" }

Metrics =>
    return Sizes { page = "1120px", gutter = "clamp(20px, 4vw, 40px)", tap = "46px", chip = "2.6rem", button = "15px", field = "16px", label = "11px", meta = "12.5px", radius_control = ".4rem", radius_chip = ".65rem", radius_inner = ".6rem", radius_card = ".75rem", radius_pill = "999px", space_s = ".5rem", space_m = "1rem", space_l = "1.5rem" }

UseTheme { name ∈ String } =>
    theme = name
    return Used

| ── Icons ──────────────────────────────────────────────

emit UiIcon { name = "bin" } to this get bin
assert bin.value.tag = "svg"
assert bin.value.attrs.class = "ui-icon"
assert bin.value.children[0].attrs.stroke = "currentColor"
emit UiIcon { name = "no-such-icon" } to this get none
assert none.value.tag = "span"
assert none.value.children = []

| ── Buttons ────────────────────────────────────────────

emit UiButton { label = "Save", click = { _class = "Saved", id = 3 }, kind = "primary" } to this get save
assert save.value = { tag = "button", attrs = { class = "ui-button primary", type = "button" }, on = { click = { _class = "Saved", id = 3 } }, children = ["Save"] }
emit UiButton { label = "Plain", click = "Pressed", kind = null } to this get plain
assert plain.value.attrs.class = "ui-button"
assert plain.value.on.click = "Pressed"
| No press: drawn without one.
emit UiButton { label = "Soon", click = null, kind = "" } to this get idle
assert idle.value.on = {}

emit UiIconButton { icon = "close", label = "Close", click = "Closed", kind = "quiet" } to this get x
assert x.value.attrs.class = "ui-icon-button quiet"
assert x.value.attrs["aria-label"] = "Close"
assert x.value.attrs.title = "Close"
assert x.value.children[0].tag = "svg"

emit UiDeleteButton { label = "Delete the task", click = { _class = "AskDelete", id = 7 } } to this get del
assert del.value.attrs.class = "ui-icon-button quiet delete"
assert del.value.on.click = { _class = "AskDelete", id = 7 }
assert del.value.children[0].children[0].attrs.d = "M5 7h14m-9 4v6m4-6v6M9 7V4h6v3m-9 0 1 14h10l1-14"

| ── Choosing ───────────────────────────────────────────

emit UiTabs { items = [{ label = "House", click = { _class = "Tab", id = "house" }, picked = true }, { label = "Devices", click = { _class = "Tab", id = "devices" }, picked = false }] } to this get tabs
assert tabs.value.tag = "nav"
assert tabs.value.attrs.class = "ui-tabs"
assert tabs.value.children[0].attrs = { class = "ui-tab picked", type = "button", "aria-current" = "page" }
assert tabs.value.children[1].attrs = { class = "ui-tab", type = "button" }
assert tabs.value.children[1].on.click = { _class = "Tab", id = "devices" }

emit UiChips { items = [{ label = "All", click = "All", picked = false }, { label = "Urgent", click = "Urgent", picked = true }] } to this get chips
assert chips.value.attrs.class = "ui-chips"
assert chips.value.children[0].attrs["aria-pressed"] = "false"
assert chips.value.children[1].attrs.class = "ui-chip picked"
assert chips.value.children[1].attrs["aria-pressed"] = "true"

| ── Fields ─────────────────────────────────────────────

emit UiInput { name = "title", value = 42, placeholder = "What needs doing?", type = null, change = "TitleTyped" } to this get input
assert input.value.tag = "input"
assert input.value.attrs = { class = "ui-input", name = "title", id = "title", value = "42", placeholder = "What needs doing?", type = "text" }
assert input.value.on = { input = "TitleTyped" }
emit UiField { label = "Title", control = input.value, hint = "", error = "A title is needed" } to this get field
assert field.value.tag = "label"
assert field.value.children[0] = { tag = "span", attrs = { class = "ui-field-label" }, children = ["Title"] }
assert field.value.children[1] = input.value
| An empty hint is left out; the error is said.
assert field.value.children[2].attrs = { class = "ui-field-error", role = "alert" }
assert field.value.children[3] = null

| ── Surfaces ───────────────────────────────────────────

emit UiCard { title = "Living room", children = ["18.4 °C"], stripe = "health", click = null } to this get card
assert card.value.tag = "article"
assert card.value.attrs.class = "ui-card stripe-health"
assert card.value.children = [{ tag = "h3", attrs = { class = "ui-card-title" }, children = ["Living room"] }, "18.4 °C"]
emit UiCard { title = null, children = ["Open"], stripe = null, click = "Opened" } to this get pressable
assert pressable.value.tag = "button"
assert pressable.value.attrs.class = "ui-card pressable"
assert pressable.value.children = ["Open"]

emit UiSectionHead { title = "Living room", note = "3 devices" } to this get head
assert head.value.children[0].children = ["Living room"]
assert head.value.children[1].children = ["3 devices"]
emit UiSectionHead { title = "Bedroom", note = null } to this get bare
assert bare.value.children[1] = null

emit UiStatusLine { text = "The house, as of now.", state = "ok", action = null } to this get status
assert status.value.attrs.role = "status"
assert status.value.children[0].attrs.class = "ui-dot ok"
assert status.value.children[1].children = ["The house, as of now."]

emit UiEmptyState { title = "Nothing to do", text = "Add a task with +.", action = null } to this get empty
assert empty.value.attrs.class = "ui-empty"
assert empty.value.children[1].children = ["Add a task with +."]

| ── Dialogs ────────────────────────────────────────────

emit UiDialog { title = "Edit task", body = ["the form"], foot = [del.value], close = "CloseEditor" } to this get dialog
assert dialog.value.attrs.class = "ui-overlay"
| The scrim and the ✕ both close.
assert dialog.value.children[0].on.click = "CloseEditor"
panel = dialog.value.children[1]
assert panel.attrs.role = "dialog"
assert panel.attrs["aria-label"] = "Edit task"
assert panel.children[0].children[0].children = ["Edit task"]
assert panel.children[0].children[1].on.click = "CloseEditor"
assert panel.children[2].children = ["the form"]
assert panel.children[4].children = [del.value]
| No foot: no second hairline either.
emit UiDialog { title = "Details", body = ["x"], foot = [], close = "Close" } to this get footless
assert footless.value.children[1].children[3] = null

emit UiConfirmPopup { title = "Delete this task?", subject = "Buy milk", note = "It cannot be brought back.", yes = "Delete", yes_click = { _class = "Delete", id = 7 }, no = "CancelDelete" } to this get ask
assert ask.value.attrs.class = "ui-overlay ui-confirm-overlay"
assert ask.value.children[0].on.click = "CancelDelete"
popup = ask.value.children[1]
assert popup.attrs.role = "alertdialog"
card = popup.children[0]
assert card.children[0].children[0].attrs.class = "ui-ask-sign"
assert card.children[0].children[0].children[0].tag = "svg"
assert card.children[0].children[1].children = ["Delete this task?"]
assert card.children[0].children[2].children = ["Buy milk"]
assert card.children[0].children[3].children = ["It cannot be brought back."]
assert card.children[1].attrs.class = "ui-button danger ui-ask-yes"
assert card.children[1].on.click = { _class = "Delete", id = 7 }
assert popup.children[1].attrs.class = "ui-button quiet ui-ask-no"
assert popup.children[1].on.click = "CancelDelete"
assert popup.children[1].children = ["Cancel"]
| Where it is used: a framed card each, no link.
emit UiConfirmPopup { title = "Move “tram.jpg” to the trash?", subject = null, note = "It stops showing where it is used:", yes = "Move to trash", yes_click = "BinAnyway", no = "KeepIt", refs = [{ label = "Keepsake: The last tram", note = "a memory" }] } to this get ask_refs
refs = ask_refs.value.children[1].children[0].children[0].children[3]
assert refs.attrs.class = "ui-ask-refs"
assert refs.children[0].children[0].children = ["Keepsake: The last tram"]
assert refs.children[0].children[1].children = ["a memory"]

| ── Numbers drawn ──────────────────────────────────────

emit UiBar { pct = 140, level = "danger" } to this get full
assert full.value.children[0].attrs = { class = "ui-bar-fill danger", style = "width:100%" }
emit UiBar { pct = null, level = null } to this get nothing
assert nothing.value.children[0].attrs.style = "width:0%"

emit UiSparkline { values = [20, null, 100], low = 20, high = 100, limit = 60, label = "Temperature", start = "24 h ago", finish = "now" } to this get line
assert line.value.children[0].children = ["Temperature"]
chart = line.value.children[1]
assert chart.tag = "svg"
assert chart.children[0].attrs.y1 = "30"
assert chart.children[1].attrs.points = "0,60 300,0"
assert line.value.children[2].children[1].children = ["now"]
emit UiSparkline { values = [5], low = 0, high = 10, limit = null, label = null, start = null, finish = null } to this get short
assert short.value.children[0].children = ["Not enough readings yet"]

emit UiPage { children = ["x"] } to this get page
assert page.value = { tag = "main", attrs = { class = "ui-page" }, children = ["x"] }

| ── The stylesheet, both themes ────────────────────────

emit UiBaseStyles to this get dark
assert dark.value[".ui-button.primary"].background = "#2f81f7"
assert dark.value[".ui-tab.picked"].background = "#2f81f7"
assert dark.value[".ui-card"]["border-radius"] = ".75rem"
assert dark.value[".ui-button"]["min-height"] = "46px"
assert dark.value[".ui-input, .ui-field select, .ui-field textarea"]["font-size"] = "16px"
emit UseTheme { name = "light" } to this
emit UiBaseStyles to this get light
assert light.value[".ui-button.primary"].background = "#0969da"
assert light.value[".ui-card"].background = "#f6f8fa"
| Every class a component draws has its rule.
loop name over [".ui-button", ".ui-icon-button", ".ui-tabs", ".ui-tab", ".ui-chips", ".ui-chip", ".ui-field", ".ui-field-label", ".ui-card", ".ui-section-head", ".ui-status-line", ".ui-dot", ".ui-empty", ".ui-overlay", ".ui-scrim", ".ui-dialog", ".ui-dialog-head", ".ui-dialog-foot", ".ui-divider", ".ui-bar", ".ui-bar-fill", ".ui-spark", ".ui-spark-chart", ".ui-page", ".ui-icon"]
    assert light.value[name] ∈ Object


| ── From To Do (tickets 350, 353–355) ──────────────────

emit UiSegmented { label = "Priority", items = [{ label = "High", click = { _class = "Picked", value = "High" }, picked = true, dot = "#eab308" }, { label = "Low", click = "PickLow", picked = false, dot = null }] } to this get seg
assert seg.value.attrs = { class = "ui-seg", role = "group", "aria-label" = "Priority" }
assert seg.value.children[0].attrs.class = "ui-seg-option picked"
assert seg.value.children[0].attrs["aria-pressed"] = "true"
assert seg.value.children[0].children[0].attrs.style = "background:#eab308"
assert seg.value.children[0].children[1] = "High"
assert seg.value.children[1].children = ["Low"]
assert seg.value.children[1].on.click = "PickLow"

emit UiToast { text = "✓ Saved", tone = "ok" } to this get toast
assert toast.value = { tag = "div", attrs = { class = "ui-toast ok", role = "status" }, children = ["✓ Saved"] }

emit UiMenuButton { label = "More for this task", open = true, click = "ToggleMenu" } to this get more
assert more.value.attrs["aria-expanded"] = "true"
assert more.value.attrs["aria-haspopup"] = "menu"
assert more.value.on.click = "ToggleMenu"
emit UiMenu { label = "This task", items = [{ label = "Duplicate", click = "Dup", danger = false, icon = null }, { label = "Delete task", click = { _class = "AskDelete", id = 7 }, danger = true, icon = "bin" }], close = "CloseMenu", place = "above-start" } to this get menu
assert menu.value[0].on.click = "CloseMenu"
assert menu.value[1].attrs.class = "ui-menu above start"
assert menu.value[1].attrs.role = "menu"
assert menu.value[1].children[0].attrs.class = "ui-menu-item"
assert menu.value[1].children[1].attrs.class = "ui-menu-item danger"
assert menu.value[1].children[1].children[0].tag = "svg"
assert menu.value[1].children[1].on.click = { _class = "AskDelete", id = 7 }

emit UiAddButton { label = "Photo", icon = "camera", click = "AttachPhoto" } to this get add_photo
assert add_photo.value.attrs.class = "ui-add"
assert add_photo.value.children[0].tag = "svg"
assert add_photo.value.children[1] = "Photo"
emit UiAddButton { label = "+ Add tag", icon = null, click = "AddTag" } to this get add_tag
assert add_tag.value.children = ["+ Add tag"]

emit UiSearchField { value = "", placeholder = "Search tags", label = "Search tags", change = "Typed", clear = "Cleared" } to this get search_empty
assert search_empty.value.attrs.class = "ui-search"
assert search_empty.value.children[1].attrs.type = "search"
assert search_empty.value.children[1].on.input = "Typed"
| Nothing typed: no ×.
assert search_empty.value.children = [search_empty.value.children[0], search_empty.value.children[1]]
emit UiSearchField { value = "re", placeholder = null, label = "Search tags", change = "Typed", clear = "Cleared" } to this get search_typed
assert search_typed.value.children[1].attrs.value = "re"
assert search_typed.value.children[2].on.click = "Cleared"

emit UiSheet { title = "Add tags", body = ["rows"], foot = ["done"], close = "CloseSheet" } to this get sheet
assert sheet.value.attrs.class = "ui-overlay ui-sheet-overlay"
assert sheet.value.children[0].on.click = "CloseSheet"
assert sheet.value.children[1].attrs.role = "dialog"
assert sheet.value.children[1].children[2] = { tag = "div", attrs = { class = "ui-sheet-body" }, children = ["rows"] }
assert sheet.value.children[1].children[3].children = ["done"]

emit UiListRow { lead = null, text = "Export bank statements", note = "", trail = "1", click = { _class = "Open", id = 1 } } to this get row
assert row.value.tag = "button"
assert row.value.attrs.class = "ui-row pressable"
assert row.value.children[0].children[0].children = ["Export bank statements"]
assert row.value.children[1].children = ["1"]
emit UiListAdd { label = "Add a subtask", click = "AddStep" } to this get add_row
assert add_row.value.attrs.class = "ui-row ui-row-add"
emit UiList { rows = [row.value, add_row.value] } to this get list
assert list.value.attrs.class = "ui-list"

emit UiPill { path = "Work › ", label = "Reports", remove = { _class = "ToggleTag", path = "Work/Reports" }, remove_label = "Remove tag Reports" } to this get pill
assert pill.value.children[0].children[0] = { tag = "span", attrs = { class = "ui-pill-path" }, children = ["Work › "] }
assert pill.value.children[1].attrs["aria-label"] = "Remove tag Reports"
emit UiPill { path = null, label = "Health", remove = null, remove_label = null } to this get bare_pill
assert bare_pill.value.children = [{ tag = "span", attrs = { class = "ui-pill-name" }, children = ["Health"] }]

emit UiPageHead { title = "Tags", note = "8 tags", action = "edit" } to this get page_head
assert page_head.value.children[0].children = [{ tag = "h1", attrs = { class = "ui-page-title" }, children = ["Tags"] }, "edit"]
assert page_head.value.children[1].children = ["8 tags"]

| Every new class has its rule, in both themes.
emit UseTheme { name = "dark" } to this
emit UiBaseStyles to this get sheet_dark
assert sheet_dark.value[".ui-seg-option.picked, .ui-seg-option.picked:hover"] ≠ null
assert sheet_dark.value[".ui-menu-item.danger"].color = "#f85149"
assert sheet_dark.value[".ui-add"]["border"] = "1px dashed #30363d"
emit UseTheme { name = "light" } to this
emit UiBaseStyles to this get sheet_light
assert sheet_light.value[".ui-add"].color = "#0969da"
assert sheet_light.value[".ui-add:hover"].background = "#ddf4ff"
emit UseTheme { name = "dark" } to this

| ── Screens (2026-11-27) ───────────────────────────────

emit UiPageNarrow { children = ["x"] } to this get narrow
assert narrow.value = { tag = "main", attrs = { class = "ui-page narrow" }, children = ["x"] }
emit UiToolbar { children = ["search"] } to this get toolbar
assert toolbar.value.attrs.class = "ui-toolbar"

emit UiIcon { name = "folder" } to this get folder_icon
emit UiItemCard { lead = folder_icon.value, title = "Belgeler", meta = "3 files", stripe = null, trail = "›", click = { _class = "OpenFolder", value = "f1" } } to this get folder_card
assert folder_card.value.tag = "button"
assert folder_card.value.attrs.class = "ui-item"
assert folder_card.value.on.click = { _class = "OpenFolder", value = "f1" }
assert folder_card.value.children[0].children[0].tag = "svg"
assert folder_card.value.children[1].children[0].children = ["Belgeler"]
assert folder_card.value.children[1].children[1].children = ["3 files"]
assert folder_card.value.children[2].children = ["›"]
emit UiItemCard { lead = null, title = "Buy milk", meta = ["High", " · 2 days late"], stripe = "warn", trail = null, click = null } to this get task_card
assert task_card.value.tag = "div"
assert task_card.value.attrs.class = "ui-item stripe-warn"
assert task_card.value.children[0].children[1].children = ["High", " · 2 days late"]

emit UiFab { label = "Add", open = false, click = "ToggleDial" } to this get fab
assert fab.value.attrs.class = "ui-fab"
assert fab.value.attrs["aria-expanded"] = "false"
emit UiFab { label = "Add", open = true, click = "ToggleDial" } to this get fab_open
assert fab_open.value.attrs["aria-expanded"] = "true"
emit UiDial { label = "Add", items = [{ label = "Upload files", icon = "upload", click = "Upload" }, { label = "New folder", icon = "folder", click = "NewFolder" }], close = "CloseDial" } to this get dial
assert dial.value[0].on.click = "CloseDial"
assert dial.value[1].attrs.class = "ui-dial"
assert dial.value[1].children[1].on.click = "NewFolder"
assert dial.value[1].children[1].children[1].children = ["New folder"]

emit UiPathLine { crumbs = [{ label = "Drive", click = { _class = "OpenFolder", value = "" } }], here = "2026", action = null } to this get path
assert path.value.tag = "nav"
assert path.value.children[0].on.click = { _class = "OpenFolder", value = "" }
assert path.value.children[2].children = ["2026"]
emit UiPathLine { crumbs = [], here = "Fotoğraflar", action = "menu" } to this get path_menu
assert path_menu.value.children[1].children = ["menu"]

emit UiItemPage { title = "letter.pdf", body = ["preview"], foot = ["more"] } to this get item_page
assert item_page.value.attrs.class = "ui-item-page"
assert item_page.value.children[0].children = ["letter.pdf"]
assert item_page.value.children[2].children = ["more"]

emit UseTheme { name = "dark" } to this
emit UiBaseStyles to this get screen_rules
assert screen_rules.value[".ui-page.narrow"].width = "min(100%, 40rem)"
assert screen_rules.value[".ui-item.stripe-warn"]["border-left-color"] = "#d29922"
assert screen_rules.value[".ui-fab"].background = "#2f81f7"

emit UiTitleField { value = "letter.pdf", label = "Name", change = "NameTyped", rows = 2 } to this get title_field
assert title_field.value.tag = "textarea"
assert title_field.value.attrs.rows = "2"
assert title_field.value.on.input = "NameTyped"
assert title_field.value.children = ["letter.pdf"]
emit UiItemPage { title = title_field.value, body = [], foot = [] } to this get editable_page
assert editable_page.value.children[0].tag = "textarea"
emit UiBaseStyles to this get title_rules
assert title_rules.value[".ui-title-field"]["font-size"] = "1.375rem"

emit UiPathLine { crumbs = [{ label = "Drive", click = "Top" }, { label = "Belgeler", click = "Up" }], here = "", action = null } to this get item_path
assert item_path.value.children[0].children = ["Drive"]
assert item_path.value.children[1].children = ["›"]
assert item_path.value.children[2].children = ["Belgeler"]
assert item_path.value.children[3] = null
emit UiIcon { name = "download" } to this get down
assert down.value.tag = "svg"

emit UiActionSheet { title = "old.txt", note = "In the trash", actions = [{ label = "Restore", click = { _class = "Restore", id = 1 }, danger = false }, { label = "Delete for good", click = "AskForever", danger = true }], no = "CloseActions" } to this get acts
assert acts.value.children[0].on.click = "CloseActions"
sheet_card = acts.value.children[1].children[0]
assert sheet_card.children[0].children[0].children = ["old.txt"]
assert sheet_card.children[1].attrs.class = "ui-ask-line"
assert sheet_card.children[1].on.click = { _class = "Restore", id = 1 }
assert sheet_card.children[2].attrs.class = "ui-ask-line danger"
assert acts.value.children[1].children[1].children = ["Cancel"]
